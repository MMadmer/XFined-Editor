#include "common.h"

struct 	v2p
{
 	float2 	tc0: 		TEXCOORD0;	// base
	float3	tc1:		TEXCOORD1;	// environment
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: SV_Target
{
	float4	t_base 	= s_base.Sample	(smp_base,		I.tc0);
	// s_env is bound with D3DTADDRESS_CLAMP + linear, which is what smp_rtlinear is
	float4	t_env 	= s_env.Sample	(smp_rtlinear,	I.tc1);

	// lighting

	// final-color
	float3 	base 	= lerp	(t_env.rgb,t_base.rgb,t_base.a);
	float3	final 	= base;

	// out
	return  float4	(final.r,final.g,final.b,t_base.a);
}
