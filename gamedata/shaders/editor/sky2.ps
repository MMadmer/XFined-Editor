#include "common.h"

struct 	v2p
{
	float4 	factor:	COLOR0;
  	float3	tc0:	TEXCOORD0;
  	float3	tc1:	TEXCOORD1;
};

// Slots are resolved by name through reflection (r_dx10Texture "s_sky0"/"s_sky1"),
// so no explicit register() is needed - and an explicit t0 would clash with s_base.
TextureCube 	s_sky0;
TextureCube 	s_sky1;
uniform float3 		color;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: SV_Target
{
	float3 	s0	= s_sky0.Sample(smp_rtlinear, I.tc0).rgb;
	float3 	s1	= s_sky1.Sample(smp_rtlinear, I.tc1).rgb;
	float3	sky	= I.factor.rgb*lerp(s0,s1,I.factor.w);

	return  float4	(sky,1);
}
