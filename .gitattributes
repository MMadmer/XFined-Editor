# Auto detect text files and perform LF normalization
* text=auto

# Game data is cp1251 and must reach the engine byte for byte: line-ending
# normalization would also invite an encoding guess on files git cannot decode.
*.ltx -text

# Preserve the verified upstream LZO bytes, including its intentional EOF layout.
Source/External/LZO/** -whitespace

# Preserve the verified upstream LuaJIT blobs, including intentional whitespace.
Source/External/LuaJIT/** -whitespace

# Keep upstream LuaJIT batch files byte-exact; their blobs already use CRLF.
Source/External/LuaJIT/src/*.bat -text
