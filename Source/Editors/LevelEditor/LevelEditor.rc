// XFined Editor - application resources.
//
// The icon is the product logo the author drew; it lives once, in assets\, and
// every editor executable points at that same file so there is no second copy
// to keep in sync. VERSIONINFO is what Explorer's details pane, the file
// tooltip and the taskbar read, so it is filled in rather than left blank.

#include <winres.h>
#include "../Public/xfined_resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_XFINED_EDITOR	ICON	"../../../assets/xfined-editor-xf-logo-icon.ico"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION		1,0,0,0
	PRODUCTVERSION	1,0,0,0
	FILEFLAGSMASK	VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
	FILEFLAGS		VS_FF_DEBUG
#else
	FILEFLAGS		0x0L
#endif
	FILEOS			VOS_NT_WINDOWS32
	FILETYPE		VFT_APP
	FILESUBTYPE		VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",		"Madmer"
			VALUE "FileDescription",	"XFined Editor"
			VALUE "FileVersion",		"1.0.0.0"
			VALUE "InternalName",		"LevelEditor"
			VALUE "LegalCopyright",		"Madmer"
			VALUE "OriginalFilename",	"LevelEditor.exe"
			VALUE "ProductName",		"XFined Editor"
			VALUE "ProductVersion",		"1.0.0.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
